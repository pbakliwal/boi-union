# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string.
# For a managed Postgres (e.g. Supabase), use its "Direct connection" URI from
# Project Settings > Database > Connection string, with the real password.
DATABASE_URL=postgres://boi_user:change_me@localhost:5432/boi_union

# Set to true when DATABASE_URL points at a managed Postgres that requires TLS
# (Supabase, RDS, etc.). Leave unset/false for a local or same-box Postgres.
DATABASE_SSL=false

# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=please_change_this_to_a_long_random_value

# HTTP port the app listens on
PORT=3000

# development | production  (production enables Secure cookies — requires HTTPS)
NODE_ENV=development

# Initial admin account, created by `npm run setup`
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_now
